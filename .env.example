# Copy this file to .env and fill in the values. Never commit .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True for local development only
DEBUG=True

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins incl. https://, needed in production, e.g. https://jobportal-xxxx.a.run.app
CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite. For PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Leave empty to store resumes in ./media. Set to a GCS bucket name in production.
GS_BUCKET_NAME=
